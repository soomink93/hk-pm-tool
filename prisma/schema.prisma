generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  chairman
  president
  executive
  teamlead
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  team         String?
  department   String?
  mustChangePassword Boolean @default(false)
  assignedTasks Task[]  @relation("TaskAssignee")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Team {
  id         String     @id @default(cuid())
  name       String     @unique
  lead       String
  department String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Decision {
  id            String   @id @default(cuid())
  date          String
  content       String
  category      String   @default("기타")
  tier          String
  decider       String
  priority      String
  status        String
  createdById   String?
  createdByName String?
  escalationId  String?     @unique
  escalation    Escalation? @relation(fields: [escalationId], references: [id], onDelete: SetNull)
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
}

model Escalation {
  id        String   @id @default(cuid())
  item      String
  tier      String
  dept      String
  needed    String
  deadline  String
  status    String
  decision  Decision?
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model Notification {
  id              String   @id @default(cuid())
  recipientUserId String
  fromTeam        String
  toTeam          String
  content         String
  kind            String   @default("request")
  href            String?
  read            Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([recipientUserId, read])
}

// 캘린더 일정/이벤트 (편집: 관리자 + 신동준 이사)
model CalendarEvent {
  id            String   @id @default(cuid())
  date          String   // 시작일 YYYY-MM-DD
  endDate       String?  // 종료일 YYYY-MM-DD (없으면 당일)
  title         String
  memo          String?
  color         String   @default("#2E78D2") // 이벤트 색상(hex)
  createdById   String
  createdByName String
  createdAt     DateTime @default(now())

  @@index([date])
}

// 사용자 → 관리자 요청/건의함
model AdminRequest {
  id            String   @id @default(cuid())
  content       String
  status        String   @default("대기중") // 대기중 | 처리완료
  reply         String?
  createdById   String
  createdByName String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdById])
}

enum CollabStatus {
  requested
  accepted
  in_progress
  done
  declined
}

enum TaskStatus {
  todo
  in_progress
  done
}

model Task {
  id            String     @id @default(cuid())
  title         String
  description   String     @default("")
  team          String
  assignee      String     @default("")
  assigneeId    String?
  assigneeUser  User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  status        TaskStatus @default(todo)
  priority      String     @default("mid")
  dueDate       String     @default("")
  baselineDue   String?    // 최초 계획 마감 — 마감을 수정해도 유지(밀림 비교용)
  createdById   String
  createdByName String
  collaborationId String?
  collaboration   Collaboration? @relation(fields: [collaborationId], references: [id], onDelete: SetNull)
  comments      TaskComment[]
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([team, status])
  @@unique([collaborationId])
  @@index([assigneeId])
  @@index([projectId])
}

model Collaboration {
  id            String       @id @default(cuid())
  fromTeam      String
  toTeam        String
  content       String
  status        CollabStatus @default(requested)
  priority      String       @default("mid")
  dueDate       String       @default("")
  createdById   String
  createdByName String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  comments      CollaborationComment[]
  tasks         Task[]
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([toTeam, status])
  @@index([fromTeam, status])
  @@index([projectId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actorName String
  action    String
  entity    String
  entityId  String?
  summary   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

model CollaborationComment {
  id              String        @id @default(cuid())
  collaborationId String
  collaboration   Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  authorId        String
  authorName      String
  body            String
  createdAt       DateTime      @default(now())

  @@index([collaborationId])
}

model TaskComment {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId   String
  authorName String
  body       String
  createdAt  DateTime @default(now())

  @@index([taskId])
}

enum ProjectStatus {
  active
  onhold
  done
}

model Project {
  id            String        @id @default(cuid())
  name          String
  description   String        @default("")
  status        ProjectStatus @default(active)
  ownerId       String?
  ownerName     String        @default("")
  dueDate       String        @default("")
  createdById   String
  createdByName String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tasks          Task[]
  collaborations Collaboration[]
  escalations    Escalation[]
  decisions      Decision[]

  @@index([status])
}

model Brief {
  id          String   @id @default(cuid())
  team        String
  week        String
  completed   String
  nextGoal    String
  risk        String
  escalation  String
  status      String
  submittedAt String
  collaborations Json  @default("[]")
  createdAt   DateTime @default(now())
}

// ───────── 수주·생산 일정 (hk-order-tracker 이식) ─────────
// 날짜는 'YYYY-MM-DD' 문자열. 금액은 민감정보라 보관하지 않음.

enum OrderStatus {
  active
  hold
  done
}

enum ProductType {
  undecided
  mass
  custom
  oem
}

enum StageStatus {
  todo
  doing
  done
  skip
}

model Order {
  id           String      @id @default(cuid())
  orderNo      String      @default("") // 수주번호
  customer     String // 고객사
  product      String // 품목
  quantity     String      @default("")
  dueDate      String      @default("") // 계약 납기
  specialTerms String      @default("") // 특약사항
  notes        String      @default("")
  productType  ProductType @default(undecided)
  status       OrderStatus @default(active)
  completedAt  String? // 수주 완료일 (전 단계 완료 또는 영업이 완료 처리)
  createdBy    String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  stages Stage[]
  logs   OrderLog[]
  files  OrderFile[]

  @@index([status])
}

model Stage {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seq       Int
  name      String
  team      String // 담당팀 (Team.name)
  assignee  String      @default("")
  start     String
  end       String
  baseStart String // 최초 계획 (지연 비교용)
  baseEnd   String
  status    StageStatus @default(todo)
  startedAt String? // 실제 착수일 (상태 → 진행)
  doneAt    String? // 실제 완료일 (상태 → 완료)

  @@unique([orderId, seq])
}

// 댓글 + 변경이력 + 인계 한 타임라인 (kind: comment | change | handoff)
model OrderLog {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind      String
  text      String
  actor     String
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

// ponytail: 첨부를 DB bytea에 저장 — 파일당 4MB(Vercel 요청 한도) 이하 전제. 커지면 Supabase Storage로.
model OrderFile {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name       String
  mime       String
  size       Int
  data       Bytes
  uploadedBy String
  createdAt  DateTime @default(now())
}
