generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  chairman
  president
  executive
  teamlead
}

enum TeamStatus {
  green
  yellow
  red
  gray
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  team         String?
  department   String?
  mustChangePassword Boolean @default(false)
  assignedTasks Task[]  @relation("TaskAssignee")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Team {
  id         String     @id @default(cuid())
  name       String     @unique
  lead       String
  department String?
  status     TeamStatus @default(gray)
  submitted  Boolean    @default(false)
  risk       String     @default("없음")
  escalation String     @default("없음")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Kpi {
  id        String   @id @default(cuid())
  team      String
  metric    String
  target    Float
  current   Float
  unit      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Decision {
  id            String   @id @default(cuid())
  date          String
  content       String
  category      String   @default("기타")
  tier          String
  decider       String
  priority      String
  status        String
  createdById   String?
  createdByName String?
  escalationId  String?     @unique
  escalation    Escalation? @relation(fields: [escalationId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Escalation {
  id        String   @id @default(cuid())
  item      String
  tier      String
  dept      String
  needed    String
  deadline  String
  status    String
  decision  Decision?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id              String   @id @default(cuid())
  recipientUserId String
  fromTeam        String
  toTeam          String
  content         String
  kind            String   @default("request")
  href            String?
  read            Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([recipientUserId, read])
}

enum CollabStatus {
  requested
  accepted
  in_progress
  done
  declined
}

enum TaskStatus {
  todo
  in_progress
  done
}

model Task {
  id            String     @id @default(cuid())
  title         String
  description   String     @default("")
  team          String
  assignee      String     @default("")
  assigneeId    String?
  assigneeUser  User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  status        TaskStatus @default(todo)
  priority      String     @default("mid")
  dueDate       String     @default("")
  createdById   String
  createdByName String
  collaborationId String?
  collaboration   Collaboration? @relation(fields: [collaborationId], references: [id], onDelete: SetNull)
  comments      TaskComment[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([team, status])
  @@index([collaborationId])
  @@index([assigneeId])
}

model Collaboration {
  id            String       @id @default(cuid())
  fromTeam      String
  toTeam        String
  content       String
  status        CollabStatus @default(requested)
  priority      String       @default("mid")
  dueDate       String       @default("")
  createdById   String
  createdByName String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  comments      CollaborationComment[]
  tasks         Task[]

  @@index([toTeam, status])
  @@index([fromTeam, status])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actorName String
  action    String
  entity    String
  entityId  String?
  summary   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity])
}

model CollaborationComment {
  id              String        @id @default(cuid())
  collaborationId String
  collaboration   Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  authorId        String
  authorName      String
  body            String
  createdAt       DateTime      @default(now())

  @@index([collaborationId])
}

model TaskComment {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId   String
  authorName String
  body       String
  createdAt  DateTime @default(now())

  @@index([taskId])
}

model Brief {
  id          String   @id @default(cuid())
  team        String
  week        String
  completed   String
  nextGoal    String
  risk        String
  escalation  String
  status      String
  submittedAt String
  collaborations Json  @default("[]")
  createdAt   DateTime @default(now())
}
