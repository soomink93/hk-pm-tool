generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  chairman
  president
  executive
  teamlead
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  title        String?  // 직급(실장·이사·과장 등) — 시스템 역할과 별개
  team         String?
  department   String?
  mustChangePassword Boolean @default(false)
  assignedTasks Task[]  @relation("TaskAssignee")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Team {
  id         String     @id @default(cuid())
  name       String     @unique
  lead       String
  department String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Decision {
  id            String   @id @default(cuid())
  date          String
  content       String
  category      String   @default("기타")
  tier          String
  decider       String
  priority      String
  status        String
  createdById   String?
  createdByName String?
  escalationId  String?     @unique
  escalation    Escalation? @relation(fields: [escalationId], references: [id], onDelete: SetNull)
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
}

model Escalation {
  id        String   @id @default(cuid())
  item      String
  tier      String
  dept      String
  needed    String
  deadline  String
  status    String
  decision  Decision?
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model Notification {
  id              String   @id @default(cuid())
  recipientUserId String
  fromTeam        String
  toTeam          String
  content         String
  kind            String   @default("request")
  href            String?
  read            Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([recipientUserId, read])
}

// 캘린더 일정/이벤트 (편집: 관리자 + 신동준 이사)
model CalendarEvent {
  id            String   @id @default(cuid())
  date          String   // 시작일 YYYY-MM-DD
  endDate       String?  // 종료일 YYYY-MM-DD (없으면 당일)
  title         String
  memo          String?
  color         String   @default("#2E78D2") // 이벤트 색상(hex)
  createdById   String
  createdByName String
  createdAt     DateTime @default(now())

  @@index([date])
}

// 사용자 → 관리자 요청/건의함
model AdminRequest {
  id            String   @id @default(cuid())
  content       String
  status        String   @default("대기중") // 대기중 | 처리완료
  reply         String?
  createdById   String
  createdByName String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdById])
}

enum CollabStatus {
  requested
  accepted
  in_progress
  done
  declined
}

enum TaskStatus {
  todo
  in_progress
  done
}

model Task {
  id            String     @id @default(cuid())
  title         String
  description   String     @default("")
  team          String
  assignee      String     @default("")
  assigneeId    String?
  assigneeUser  User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  status        TaskStatus @default(todo)
  priority      String     @default("mid")
  dueDate       String     @default("")
  baselineDue   String?    // 최초 계획 마감 — 마감을 수정해도 유지(밀림 비교용)
  createdById   String
  createdByName String
  collaborationId String?
  collaboration   Collaboration? @relation(fields: [collaborationId], references: [id], onDelete: SetNull)
  comments      TaskComment[]
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([team, status])
  @@unique([collaborationId])
  @@index([assigneeId])
  @@index([projectId])
}

model Collaboration {
  id            String       @id @default(cuid())
  fromTeam      String
  toTeam        String
  content       String
  status        CollabStatus @default(requested)
  priority      String       @default("mid")
  dueDate       String       @default("")
  createdById   String
  createdByName String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  comments      CollaborationComment[]
  tasks         Task[]
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([toTeam, status])
  @@index([fromTeam, status])
  @@index([projectId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actorName String
  action    String
  entity    String
  entityId  String?
  summary   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

model CollaborationComment {
  id              String        @id @default(cuid())
  collaborationId String
  collaboration   Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  authorId        String
  authorName      String
  body            String
  createdAt       DateTime      @default(now())

  @@index([collaborationId])
}

model TaskComment {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId   String
  authorName String
  body       String
  createdAt  DateTime @default(now())

  @@index([taskId])
}

enum ProjectStatus {
  active
  onhold
  done
}

model Project {
  id            String        @id @default(cuid())
  name          String
  description   String        @default("")
  status        ProjectStatus @default(active)
  ownerId       String?
  ownerName     String        @default("")
  dueDate       String        @default("")
  createdById   String
  createdByName String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tasks          Task[]
  collaborations Collaboration[]
  escalations    Escalation[]
  decisions      Decision[]

  @@index([status])
}

// ───────── 수주·생산 일정 (hk-order-tracker 이식) ─────────
// 날짜는 'YYYY-MM-DD' 문자열. 금액은 민감정보라 보관하지 않음.

enum OrderStatus {
  active
  hold
  done
}

enum ProductType {
  undecided
  mass
  custom
  oem
}

enum StageStatus {
  todo
  doing
  done
  skip
}

model Order {
  id           String      @id @default(cuid())
  orderNo      String      @default("") // 수주번호
  customer     String // 고객사
  product      String // 모델명 (UI: 모델)
  laserSource  String      @default("") // 발진기 타입 (Raycus/IPG/nLight…)
  laserPower   String      @default("") // 발진기 출력 (예: 6kW)
  head         String      @default("") // 헤드 (Precitec/Bochu/Raytools…)
  headModel    String      @default("") // 헤드 모델 (예: Procutter 2.0)
  quantity     String      @default("") // (구) 수량 — 폼에서는 제거, 기존 데이터 보존
  dueDate      String      @default("") // 계약 납기
  specialTerms String      @default("") // 특약사항
  notes        String      @default("")
  productType  ProductType @default(undecided)
  status       OrderStatus @default(active)
  completedAt  String? // 수주 완료일 (전 단계 완료 또는 영업이 완료 처리)
  createdBy    String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  stages Stage[]
  logs   OrderLog[]
  files  OrderFile[]

  // ERP 품목 연동 — 선택(nullable). 저장 시 모델이 품목 마스터와 일치하면 자동 연결(match.ts)
  materialId String?
  material   Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([materialId])
}

model Stage {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seq       Int
  name      String
  team      String // 담당팀 (Team.name)
  assignee  String      @default("")
  start     String
  end       String
  baseStart String // 최초 계획 (지연 비교용)
  baseEnd   String
  status    StageStatus @default(todo)
  startedAt String? // 실제 착수일 (상태 → 진행)
  doneAt    String? // 실제 완료일 (상태 → 완료)

  @@unique([orderId, seq])
}

// 댓글 + 변경이력 + 인계 한 타임라인 (kind: comment | change | handoff)
model OrderLog {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind      String
  text      String
  actor     String
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

enum PartnerRole {
  customer // 고객
  supplier // 공급사
  both     // 고객 겸 공급사
}

// 고객사/거래처 마스터 — 수주의 customer(자유 입력 이름)와 key(정규화 이름)로 연결.
// CRM 연동 대비: crmSource+crmId로 외부 회사(Account)와 1:1 매핑, 미연동이면 null.
// ERP 기준정보: role·code·사업자번호 등은 영업이 등록·보완(미입력이면 빈값/null, 자동 생성 고객과 공존).
model Customer {
  id          String         @id @default(cuid())
  key         String         @unique // customerKey(name) — lib/customers/key.ts
  name        String // 처음 기록될 때의 표시 이름
  // ── ERP 거래처 필드 (선택 입력) ──
  code         String?       @unique // 거래처코드(채번) — 미지정 가능
  role         PartnerRole   @default(customer) // 구분(고객/공급사/둘다)
  bizRegNo     String        @default("") // 사업자등록번호 (해외=빈값, 부분 유니크)
  ceo          String        @default("") // 대표자
  bizType      String        @default("") // 업태
  bizItem      String        @default("") // 종목
  country      String        @default("KR")
  currency     String        @default("KRW")
  address      String        @default("")
  paymentTerms String        @default("") // 결제조건
  active       Boolean       @default(true) // 사용여부(소프트삭제)
  memo         String        @default("") // 거래처 메모(공용 기록 CustomerNote와 별개)
  // ── CRM ──
  crmSource   String? // 예: hubspot, salesforce
  crmId       String?
  crmSyncedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  notes       CustomerNote[]
  contacts    CustomerContact[]

  @@unique([crmSource, crmId])
  @@index([role, active])
}

// 거래처 담당자(복수) — 영업·구매 연락처
model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String // 담당자명
  title      String   @default("") // 직책
  phone      String   @default("")
  email      String   @default("")
  isPrimary  Boolean  @default(false) // 주 담당자
  createdAt  DateTime @default(now())

  @@index([customerId])
}

// 고객사 공용 기록 — 같은 고객사의 모든 수주에서 보임
model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  text       String
  actor      String
  orderId    String? // 어느 수주 화면에서 남겼는지 (수주 삭제돼도 기록 유지 → FK 없음)
  crmId      String? // CRM으로 보낸 노트 ID (동기화 추적)
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}

// ponytail: 첨부를 DB bytea에 저장 — 파일당 4MB(Vercel 요청 한도) 이하 전제. 커지면 Supabase Storage로.
model OrderFile {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name       String
  mime       String
  size       Int
  data       Bytes
  uploadedBy String
  createdAt  DateTime @default(now())
}

// ───────── ERP 품목/모델 · BOM ─────────
enum MaterialType {
  FG    // 완제품 (레이저 절단기 모델)
  SEMI  // 반제품
  RAW   // 원자재
  PART  // 부품
  MERCH // 상품(사입)
}

model Material {
  id          String       @id @default(cuid())
  code        String       @unique // 품목코드(채번)
  name        String // 품목명
  type        MaterialType @default(PART) // 품목구분
  uom         String       @default("EA") // 단위
  manageStock Boolean      @default(true) // 재고관리여부
  manageLot   Boolean      @default(false) // LOT관리여부
  modelBase   String       @default("") // 완제품: FC/HD/FS/RS/K315
  size        String       @default("") // 완제품: 3015/4020…
  active      Boolean      @default(true)
  memo        String       @default("")
  bomParents  Bom[]        @relation("BomParent")
  bomChildren Bom[]        @relation("BomChild")
  orders      Order[]
  createdBy   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([type, active])
}

model Bom {
  id        String   @id @default(cuid())
  parentId  String // 상위품목 (FG/SEMI)
  parent    Material @relation("BomParent", fields: [parentId], references: [id], onDelete: Cascade)
  childId   String // 하위품목
  child     Material @relation("BomChild", fields: [childId], references: [id], onDelete: Restrict)
  qty       Float    @default(1) // 소요량
  uom       String   @default("EA")
  seq       Int      @default(0)
  notes     String   @default("")
  createdBy String
  createdAt DateTime @default(now())

  @@unique([parentId, childId])
  @@index([parentId])
}
